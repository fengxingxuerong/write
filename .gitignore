.dart_tool/
build/
.flutter-plugins
.flutter-plugins-dependencies
.packages
# 注：pubspec.lock 是 App 依赖锁定文件，应入库保证 CI/团队构建可复现
# （本行已从忽略列表移除；仅纯 library 才建议忽略 lockfile）。

# 本地验证日志
verify-logs/
build-*.log
test-*.log
build_run.log

# Windows 保留设备名误创建文件
nul
con
prn
aux


# IDE
.idea/
*.iml
.vscode/
*.swp

# 系统
.DS_Store
Thumbs.db

# 测试/覆盖率
coverage/
*.log

# 大体积数据与生成产物（不入库）
data/

# Python 缓存
__pycache__/
*.py[cod]
.ruff_cache/

# 工具交付清单（AI 助手会话记录，不入库）
.dumate/

# 密钥与敏感文件（严禁入库，一律走环境变量注入）
.env
.env.*
*.key

# 含内置 API Key 的脚本（密钥一律走环境变量注入，不入库）
# 注：scripts/generate_novel.py 曾在此列，已核实全文无硬编码密钥（只读 --api-key / NOVEL_LLM_API_KEY），
#     且 novel_pipeline.py / qa_scan_existing.py / ab_compare.py 均 import 它，必须入库。
scripts/watchdog_pipeline.ps1


# 一次性探测/诊断脚本（与 CI 口径一致：临时探针不入库、不设防）
scripts/probe/
