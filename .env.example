# 墨匠 · 密钥环境模板（**这个文件入库，.env.local 不入库**）
#
# 用法：
#   1. 复制本文件为 .env.local（已被 .gitignore 的 `.env.*` 规则覆盖，永不入库）；
#   2. 在 .env.local 里填真值（**不要**把真值写进本文件或任何入库文件）；
#   3. scripts/novel_pipeline.py / tool/live_run.py 会从环境变量或 .env.local 读取。
#
# 校验：scripts/test_secret_hygiene.py（CI 跑）会扫描「已入库文件」里是否出现
# 高熵密钥串，并断言 .env.local 处于被忽略状态。
#
# 为什么要单独强调：本项目历史上出现过「脚本里硬编码 AMD Key」的遗留
# （见 docs/quality-enhancement-log.md 第一节），而密钥一旦进了 git 历史，
# 删除文件也救不回来——只能轮换。

# AMD Radeon 端点（正文写手主力）
NOVEL_KEY_AMD=

# Sensenova（商汤）三个工作区 Key（规划 / 润色+标题 / 审校）
NOVEL_KEY_SENSE_K1=
NOVEL_KEY_SENSE_K2=
NOVEL_KEY_SENSE_K3=

# 备用端点（可选）
NOVEL_KEY_NVIDIA=
NOVEL_KEY_OPENROUTER=

# 本地模型（llama-server / Ollama）不需要 Key，但需要一个 Base URL；
# 直接写在应用设置里即可，无需放进环境变量。
# NOVEL_LLM_BASE_URL=http://127.0.0.1:19110
